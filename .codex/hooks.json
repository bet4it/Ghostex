{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/tooling/format/format-edited-file.mjs\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
